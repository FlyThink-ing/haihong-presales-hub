# 复制为 .env 后由服务器管理员填写；不要提交真实配置。
HH_HOST=127.0.0.1
HH_PORT=4173
HH_DATABASE_PATH=./data/presales-hub.db
HH_STORAGE_PATH=./storage
HH_BACKUP_PATH=./backups
HH_BACKUP_HOUR=2
HH_SESSION_HOURS=12
HH_SECURE_COOKIE=false
HH_LAUNCH_PROFILE=CORE
HH_DATA_MODE=TEST
# 旧版配置项保留供兼容；未审批报价预览导出接口已关闭，此项无法重新开启。
HH_ALLOW_UNAPPROVED_QUOTE_EXPORT=false
# 仅当应用只接受本机反向代理转发时设置为 loopback；不要信任任意公网代理头。
HH_TRUST_PROXY=
# 部署时从内部资料安装正式报价模板，路径仅由管理员配置。
# HH_QUOTE_STANDARD_TEMPLATE_PATH=./storage/templates/quote-standard-template.docx

# 首次管理员请运行 npm.cmd run init-admin，并在终端中隐式输入密码。
# 不要把真实密码、Token 或私钥保存到本文件。

# 外网生产示例：复制到服务器受限配置目录，由运维填写并限制读取权限。
HH_HOST=127.0.0.1
HH_PORT=4173
HH_DATABASE_PATH=/var/lib/haihong-presales/presales-hub.db
HH_STORAGE_PATH=/var/lib/haihong-presales/storage
HH_QUOTE_STANDARD_TEMPLATE_PATH=/etc/haihong-presales-hub/quote-standard-template.docx
HH_BACKUP_PATH=/var/backups/haihong-presales
HH_BACKUP_HOUR=2
TZ=Asia/Shanghai
HH_SESSION_HOURS=8
HH_SECURE_COOKIE=true
HH_LAUNCH_PROFILE=CORE
HH_DATA_MODE=PRODUCTION
HH_ALLOW_UNAPPROVED_QUOTE_EXPORT=false
HH_TRUST_PROXY=loopback

# 不要在本文件写入初始密码、Token、私钥或证书私钥。
